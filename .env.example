# Copy the variables needed by the selected runtime into a private environment
# store. Never commit the populated file.

# OpenCode remote MCP integration observed in the current configuration.
COMPOSIO_API_KEY=__SET_LOCALLY__

# Optional second Composio naming used by some clients.
COMPOSIO_CONSUMER_API_KEY=__SET_LOCALLY__

# Provider credentials. Supply these to the chosen runtime, not this repository.
OPENAI_API_KEY=__SET_LOCALLY__
GOOGLE_API_KEY=__SET_LOCALLY__

# CodeMem observer/runtime controls. These are optional unless the selected
# CodeMem configuration enables the corresponding feature.
CODEMEM_OBSERVER_MODEL=__SET_LOCALLY__
CODEMEM_OBSERVER_RUNTIME=__SET_LOCALLY__
CODEMEM_PLUGIN_CMD_TIMEOUT=__SET_LOCALLY__
CODEMEM_RUNNER=__SET_LOCALLY__
CODEMEM_RUNNER_FROM=__SET_LOCALLY__
CODEMEM_PROJECT=__SET_LOCALLY__

# Axel Improvement Engine location. The default is a profile-local directory.
AXEL_IMPROVE_ROOT=__SET_LOCALLY__

# Optional Paseo/runtime values. PASEO_PASSWORD is only needed when using a
# password-protected Paseo deployment.
PASEO_HOME=__SET_LOCALLY__
PASEO_LISTEN=127.0.0.1:6767
PASEO_PASSWORD=__SET_LOCALLY__

# Optional last30days providers. Keep these in the tool's private environment
# store if that integration is enabled.
BRAVE_API_KEY=__SET_LOCALLY__
EXA_API_KEY=__SET_LOCALLY__
GEMINI_API_KEY=__SET_LOCALLY__
GROQ_API_KEY=__SET_LOCALLY__
OPENROUTER_API_KEY=__SET_LOCALLY__
PARALLEL_API_KEY=__SET_LOCALLY__
PERPLEXITY_API_KEY=__SET_LOCALLY__
SCRAPECREATORS_API_KEY=__SET_LOCALLY__
SERPER_API_KEY=__SET_LOCALLY__
TRUTHSOCIAL_TOKEN=__SET_LOCALLY__
XAI_API_KEY=__SET_LOCALLY__
XQUIK_API_KEY=__SET_LOCALLY__
BSKY_HANDLE=__SET_LOCALLY__
BSKY_APP_PASSWORD=__SET_LOCALLY__
INCLUDE_SOURCES=__SET_LOCALLY__
LAST30DAYS_REDDIT_BACKEND=__SET_LOCALLY__
LAST30DAYS_X_BACKEND=__SET_LOCALLY__
XIAOHONGSHU_API_BASE=__SET_LOCALLY__
