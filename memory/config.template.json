{
  "env": "dev",
  "projects": {
    "main": {
      "path": "__AXEL_PORTABLE_ROOT__/memory/basic-memory/main",
      "mode": "local",
      "workspace_id": null,
      "local_sync_path": null,
      "bisync_initialized": false,
      "last_sync": null
    },
    "axel": {
      "path": "__AXEL_PORTABLE_ROOT__/memory/basic-memory/axel",
      "mode": "local",
      "workspace_id": null,
      "local_sync_path": null,
      "bisync_initialized": false,
      "last_sync": null
    },
    "axel-project-knowledge": {
      "path": "__AXEL_PORTABLE_ROOT__/memory/basic-memory/axel-project-knowledge",
      "mode": "local",
      "workspace_id": null,
      "local_sync_path": null,
      "bisync_initialized": false,
      "last_sync": null
    }
  },
  "default_project": "main",
  "log_level": "INFO",
  "logfire_enabled": false,
  "database_backend": "sqlite",
  "database_url": null,
  "semantic_search_enabled": true,
  "semantic_embedding_provider": "fastembed",
  "semantic_embedding_model": "bge-small-en-v1.5",
  "semantic_vector_k": 100,
  "semantic_min_similarity": 0.55,
  "db_pool_size": 20,
  "db_pool_overflow": 40,
  "db_pool_recycle": 180,
  "materialization_workers": 4,
  "sqlite_synchronous": "NORMAL",
  "sqlite_mmap_size": 268435456,
  "sqlite_wal_autocheckpoint": 1000,
  "sqlite_page_size": 4096,
  "index_delay": 1000,
  "watch_project_reload_interval": 300,
  "update_permalinks_on_move": false,
  "index_changes": true,
  "index_batch_size": 32,
  "index_batch_max_bytes": 8388608,
  "index_parse_max_concurrent": 8,
  "index_entity_max_concurrent": 4,
  "index_metadata_update_max_concurrent": 4,
  "kebab_filenames": false,
  "disable_permalinks": false,
  "write_note_overwrite_default": false,
  "cli_output_style": "rich",
  "ensure_frontmatter_on_sync": true,
  "permalinks_include_project": true,
  "skip_initialization_sync": false,
  "format_on_save": false,
  "formatter_timeout": 5.0,
  "cloud_client_id": "__SUPPLY_IF_CLOUD_MODE_IS_USED__",
  "cloud_domain": "https://eloquent-lotus-05.authkit.app",
  "cloud_host": "https://cloud.basicmemory.com",
  "cloud_api_key": null,
  "default_workspace": null
}
