{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "mcp": {
    "basic-memory": {
      "type": "local",
      "command": [
        "uvx",
        "basic-memory",
        "mcp"
      ],
      "enabled": true
    },
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "x-consumer-api-key": "{env:COMPOSIO_API_KEY}"
      }
    },
    "codemem": {
      "type": "local",
      "command": [
        "node",
        "__AXEL_PORTABLE_ROOT__/tools/integrations/codemem/packages/mcp-server/dist/stdio.js"
      ],
      "enabled": true
    },
    "wigolo": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "wigolo"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 30000
    }
  },
  "plugin": [
    "__AXEL_PORTABLE_ROOT__/tools/integrations/codemem/packages/opencode-plugin/index.js"
  ]
}
