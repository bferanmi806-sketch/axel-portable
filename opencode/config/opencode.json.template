{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "instructions": [
    "__AXEL_PROFILE_ROOT__/AGENTS.md",
    "__AXEL_PROFILE_ROOT__/identity/AXEL.md"
  ],
  "skills": {
    "paths": [
      "__AXEL_PROFILE_ROOT__/opencode/skills"
    ]
  },
  "experimental": {
    "mcp_timeout": 120000
  },
  "mcp": {
    "basic-memory": {
      "type": "local",
      "command": [
        "env",
        "BASIC_MEMORY_CONFIG_DIR=__AXEL_PROFILE_ROOT__/memory",
        "FASTMCP_SHOW_SERVER_BANNER=false",
        "__AXEL_PROFILE_ROOT__/bin/basic-memory",
        "mcp",
        "--project",
        "axel"
      ],
      "timeout": 120000,
      "enabled": true
    },
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "x-consumer-api-key": "{env:COMPOSIO_API_KEY}"
      }
    },
    "codemem": {
      "type": "local",
      "command": [
        "node",
        "__AXEL_PORTABLE_ROOT__/tools/integrations/codemem/packages/mcp-server/dist/stdio.js"
      ],
      "enabled": true
    },
    "wigolo": {
      "type": "local",
      "command": [
        "env",
        "npm_config_cache=__AXEL_PROFILE_ROOT__/npm-cache",
        "npx",
        "-y",
        "wigolo"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 30000
    }
  },
  "plugin": [
    "__AXEL_PORTABLE_ROOT__/tools/integrations/codemem/packages/opencode-plugin/index.js"
  ]
}
