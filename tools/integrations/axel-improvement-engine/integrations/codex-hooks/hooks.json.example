{
  "description": "Local-only Axel Improvement Engine capture. Replace <ABSOLUTE_PATH> and review it with /hooks.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 \"<ABSOLUTE_PATH>/capture.py\"", "commandWindows": "py -3 \"<ABSOLUTE_PATH>/capture.py\"", "timeout": 1}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "python3 \"<ABSOLUTE_PATH>/capture.py\"", "commandWindows": "py -3 \"<ABSOLUTE_PATH>/capture.py\"", "timeout": 1}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python3 \"<ABSOLUTE_PATH>/capture.py\"", "commandWindows": "py -3 \"<ABSOLUTE_PATH>/capture.py\"", "timeout": 1}]}],
    "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "python3 \"<ABSOLUTE_PATH>/capture.py\"", "commandWindows": "py -3 \"<ABSOLUTE_PATH>/capture.py\"", "timeout": 1}]}],
    "PostToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "python3 \"<ABSOLUTE_PATH>/capture.py\"", "commandWindows": "py -3 \"<ABSOLUTE_PATH>/capture.py\"", "timeout": 1}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3 \"<ABSOLUTE_PATH>/capture.py\"", "commandWindows": "py -3 \"<ABSOLUTE_PATH>/capture.py\"", "timeout": 1}]}]
  }
}
