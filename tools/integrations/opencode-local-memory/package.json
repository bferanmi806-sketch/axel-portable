{
  "name": "@axel/opencode-local-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first durable memory adapter for OpenCode",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.5",
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "1.18.5"
  }
}
